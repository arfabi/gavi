#=====================================================
# GAVI Dashboard - Environment Configuration
# Copy file ini menjadi .env dan isi nilainya
#=====================================================

# ---- App ----
CI_ENVIRONMENT = development
app.baseURL = "http://gavi.test:8080/"
app.appName = "GAVI Dashboard"

# ---- Database MySQL (lokal) ----
database.default.hostname = 127.0.0.1
database.default.database = gavi_dashboard
database.default.username = root
database.default.password =
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306

# ---- Supabase (untuk RAG pgvector) ----
supabase.url = https://xxxxxxxxxxxx.supabase.co
supabase.anon_key =
supabase.service_key =

# ---- CAPTCHA ----
# Pilih: "gd" (built-in PHP GD) atau "recaptcha"
captcha.driver = gd
captcha.recaptcha_site_key =
captcha.recaptcha_secret_key =

# ---- n8n Integration ----
n8n.webhook_url = https://n8n.example.com/webhook/gavi-trigger
n8n.api_token = gavi_secure_token_here

# ---- WAHA (WhatsApp) ----
waha.endpoint_url = http://localhost:3000
waha.session_name = default
waha.api_key =

# ---- Session ----
session.driver = CodeIgniter\Session\Handlers\FileHandler
session.cookieName = gavi_session
session.expiration = 7200
session.savePath = writable/sessions
session.matchIP = false
